# PostgreSQL connection (Neon in production, local Postgres in development).
DATABASE_URL="postgresql://user:password@localhost:5432/nabd?schema=public"

# Direct, non-pooled connection used for migrations. Locally, set it to the
# same value as DATABASE_URL; on Neon, use the direct (non-pooling) URL.
DIRECT_URL="postgresql://user:password@localhost:5432/nabd?schema=public"

# Auth.js session secret. Generate one with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-32-byte-random-secret"

# Trust the incoming Host header. Vercel sets this implicitly; for any other
# host (local `next start`, a self-hosted server) set it to true.
AUTH_TRUST_HOST=true
